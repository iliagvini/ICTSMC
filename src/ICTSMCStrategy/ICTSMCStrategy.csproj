<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!--
      ATAS X (8.0.14+) ships .NET 10 assemblies, so the project targets
      net10.0-windows by default. For an older .NET 8-based ATAS install,
      build with: dotnet build -p:AtasTfm=net8.0-windows
    -->
    <AtasTfm Condition="'$(AtasTfm)' == ''">net10.0-windows</AtasTfm>
    <TargetFramework>$(AtasTfm)</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <AssemblyName>ICTSMCStrategy</AssemblyName>
    <RootNamespace>ICTSMC</RootNamespace>
    <!-- ATAS install folder: pass /p:AtasPath=... to override; ATAS X is probed first. -->
    <AtasPath Condition="'$(AtasPath)' == '' AND Exists('C:\Program Files\ATAS X')">C:\Program Files\ATAS X</AtasPath>
    <AtasPath Condition="'$(AtasPath)' == '' AND Exists('C:\Program Files\ATAS Platform')">C:\Program Files\ATAS Platform</AtasPath>
    <AtasPath Condition="'$(AtasPath)' == ''">C:\Program Files (x86)\ATAS Platform</AtasPath>
    <EnableDefaultCompileItems>true</EnableDefaultCompileItems>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="ATAS.Indicators">
      <HintPath>$(AtasPath)\ATAS.Indicators.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="OFT.Rendering">
      <HintPath>$(AtasPath)\OFT.Rendering.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!--
    Without this, a missing/mislocated ATAS install produces hundreds of
    "The type or namespace name 'ATAS' could not be found" errors that say nothing
    about the actual cause. Fail once, clearly, with the fix.
  -->
  <Target Name="VerifyAtasReferences" BeforeTargets="BeforeBuild">
    <Message Importance="high"
             Text="ICTSMC: ATAS folder = '$(AtasPath)'  |  TargetFramework = $(TargetFramework)" />
    <Error Condition="!Exists('$(AtasPath)\ATAS.Indicators.dll')"
           Text="ATAS.Indicators.dll was not found in '$(AtasPath)'.%0A%0AThis project must be built on a machine where ATAS is installed - it links against the ATAS assemblies.%0A%0AFix: pass your ATAS folder explicitly, e.g.%0A    dotnet build src/ICTSMCStrategy/ICTSMCStrategy.csproj -c Release -p:AtasPath=&quot;C:\Program Files\ATAS X&quot;%0A%0AThe folder is the one containing ATAS.Indicators.dll and OFT.Rendering.dll (next to OFT.Platform.exe)." />
    <Error Condition="!Exists('$(AtasPath)\OFT.Rendering.dll')"
           Text="OFT.Rendering.dll was not found in '$(AtasPath)'.%0A%0AATAS.Indicators.dll resolved but OFT.Rendering.dll did not, so '$(AtasPath)' is probably not the real ATAS program folder.%0A%0AFix: point -p:AtasPath=... at the folder that contains BOTH DLLs." />
  </Target>

</Project>
