<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!--
      Current ATAS builds (8.0.14+) ship .NET 10 assemblies, so the project targets
      net10.0-windows by default. For an older .NET 8-based ATAS install,
      build with: dotnet build -p:AtasTfm=net8.0-windows
    -->
    <!--
      ATAS install folder: pass /p:AtasPath=... to override.

      Standard ATAS ("ATAS Platform") is probed FIRST, and wins whenever it and ATAS X
      are installed side by side: linking against the wrong platform's assemblies
      produces a DLL whose references the running ATAS cannot bind.

      Each candidate is probed for ATAS.Indicators.dll rather than for the folder alone.
      A directory-only test matched a leftover or partially-removed install and then
      failed the build against a folder with no assemblies in it.
    -->
    <AtasPath Condition="'$(AtasPath)' == '' AND Exists('C:\Program Files\ATAS Platform\ATAS.Indicators.dll')">C:\Program Files\ATAS Platform</AtasPath>
    <AtasPath Condition="'$(AtasPath)' == '' AND Exists('C:\Program Files (x86)\ATAS Platform\ATAS.Indicators.dll')">C:\Program Files (x86)\ATAS Platform</AtasPath>
    <AtasPath Condition="'$(AtasPath)' == '' AND Exists('C:\Program Files\ATAS X\ATAS.Indicators.dll')">C:\Program Files\ATAS X</AtasPath>
    <AtasPath Condition="'$(AtasPath)' == ''">C:\Program Files (x86)\ATAS Platform</AtasPath>

    <!--
      Pick the target framework from the runtime ATAS ACTUALLY runs on, read out of
      its own runtimeconfig.json. The install FOLDER NAME is not a reliable signal:
      an "(x86)\ATAS Platform" install can be running .NET 10, and guessing net8 for
      it produces a DLL built against the wrong framework. Override with
      -p:AtasTfm=netX.0-windows if you need to force it.
    -->
    <AtasRuntimeConfig>$(AtasPath)\OFT.Platform.runtimeconfig.json</AtasRuntimeConfig>
    <AtasRuntimeConfigText Condition="'$(AtasTfm)' == '' AND Exists('$(AtasRuntimeConfig)')">$([System.IO.File]::ReadAllText('$(AtasRuntimeConfig)'))</AtasRuntimeConfigText>
    <AtasTfm Condition="'$(AtasTfm)' == '' AND '$(AtasRuntimeConfigText)' != '' AND $(AtasRuntimeConfigText.Contains('net10.0'))">net10.0-windows</AtasTfm>
    <AtasTfm Condition="'$(AtasTfm)' == '' AND '$(AtasRuntimeConfigText)' != '' AND $(AtasRuntimeConfigText.Contains('net9.0'))">net9.0-windows</AtasTfm>
    <AtasTfm Condition="'$(AtasTfm)' == '' AND '$(AtasRuntimeConfigText)' != '' AND $(AtasRuntimeConfigText.Contains('net8.0'))">net8.0-windows</AtasTfm>
    <AtasTfm Condition="'$(AtasTfm)' == ''">net10.0-windows</AtasTfm>
    <TargetFramework>$(AtasTfm)</TargetFramework>
    <!--
      UseWindowsForms is here ONLY to pull in System.Drawing.Common (Bitmap, Graphics,
      Pen, Brush, Font) for the self-rendered chart snapshot. No WinForms and no WPF type
      is used anywhere in this project.

      Expect one warning on every build:
        MSB3277: conflicts between different versions of "WindowsBase" (v4.0.0.0 vs v10.0.0.0)
      That conflict is entirely between ATAS.Indicators.dll's own reference and the
      WindowsDesktop reference pack. This assembly neither references nor ships WindowsBase,
      and at runtime ATAS resolves it from the WPF assemblies its process has already
      loaded. It is expected, and it is not a defect to chase.

      Do NOT "fix" it by switching UseWindowsForms off or adding a System.Drawing.Common
      PackageReference without testing the built DLL inside ATAS first - that trades a
      cosmetic warning for a real dependency-resolution risk in the host process.
    -->
    <UseWindowsForms>true</UseWindowsForms>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <AssemblyName>ICTSMCStrategy</AssemblyName>
    <RootNamespace>ICTSMC</RootNamespace>
    <EnableDefaultCompileItems>true</EnableDefaultCompileItems>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="ATAS.Indicators">
      <HintPath>$(AtasPath)\ATAS.Indicators.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="OFT.Rendering">
      <HintPath>$(AtasPath)\OFT.Rendering.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!--
    Without this, a missing/mislocated ATAS install produces hundreds of
    "The type or namespace name 'ATAS' could not be found" errors that say nothing
    about the actual cause. Fail once, clearly, with the fix.
  -->
  <Target Name="VerifyAtasReferences" BeforeTargets="BeforeBuild">
    <Message Importance="high"
             Text="ICTSMC: ATAS folder = '$(AtasPath)'  |  TargetFramework = $(TargetFramework)" />
    <Error Condition="!Exists('$(AtasPath)\ATAS.Indicators.dll')"
           Text="ATAS.Indicators.dll was not found in '$(AtasPath)'.%0A%0AThis project must be built on a machine where ATAS is installed - it links against the ATAS assemblies.%0A%0AFix: pass your ATAS folder explicitly, e.g.%0A    dotnet build src/ICTSMCStrategy/ICTSMCStrategy.csproj -c Release -p:AtasPath=&quot;C:\Program Files (x86)\ATAS Platform&quot;%0A%0AThe folder is the one containing ATAS.Indicators.dll and OFT.Rendering.dll (next to OFT.Platform.exe)." />
    <Error Condition="!Exists('$(AtasPath)\OFT.Rendering.dll')"
           Text="OFT.Rendering.dll was not found in '$(AtasPath)'.%0A%0AATAS.Indicators.dll resolved but OFT.Rendering.dll did not, so '$(AtasPath)' is probably not the real ATAS program folder.%0A%0AFix: point -p:AtasPath=... at the folder that contains BOTH DLLs." />
  </Target>

</Project>
