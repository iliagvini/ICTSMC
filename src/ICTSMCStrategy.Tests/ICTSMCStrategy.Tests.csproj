<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <NoWarn>$(NoWarn);CS0649;CS8618</NoWarn>
  </PropertyGroup>

  <!-- Keep the deterministic decision rules testable without loading ATAS. -->
  <ItemGroup>
    <Compile Include="..\ICTSMCStrategy\Models.cs" Link="Models.cs" />
    <Compile Include="..\ICTSMCStrategy\StrictRules.cs" Link="StrictRules.cs" />
  </ItemGroup>
</Project>
